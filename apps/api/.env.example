PORT=3000
JWT_SECRET=replace-with-a-strong-random-secret
DB_PATH=./wellnesshub.db
# Optional: path to alert thresholds JSON; defaults to src/alertThresholds.json
ALERT_THRESHOLDS_PATH=
# Alert staleness thresholds in hours (defaults: smartwatch=18, smart_scale=18)
ALERT_STALE_SMARTWATCH_HOURS=18
ALERT_STALE_SMART_SCALE_HOURS=18
# Goal risk threshold fraction (0–1); alert fires when progress < expected * threshold (default: 0.75)
ALERT_GOAL_RISK_THRESHOLD=0.75
# JSON map of per-metric abnormal reading thresholds, e.g. {"resting_heart_rate_bpm":{"min":40,"max":100}}
ALERT_ABNORMAL_THRESHOLDS_JSON=
